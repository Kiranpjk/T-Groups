# Public address of the site (canonical URLs, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google Analytics 4 ID
NEXT_PUBLIC_GA_ID=

# SMTP Email Configuration for Nodemailer (Optional - Live or Test)
# If left blank, inquiries will log in console demo mode gracefully.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="T Group Inquiries <your-email@gmail.com>"
NOTIFICATION_EMAIL=info@tgroupexim.com
